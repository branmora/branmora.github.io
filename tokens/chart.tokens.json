    "categorical": {
      "$type": "color",
      "$description": "Only when several named series must each be told apart. Assigned in this order and never cycled; past five, fold into context gray or small multiples. Slot 1 is the highlight's own color, and every other slot sits at least 30 degrees of OKLCH hue from it. Validated with the dataviz palette checks in every set: adjacent pairs for all five, all pairs for the first three. The dark sets keep slots 2 to 5 inside the dark lightness band, which puts crimson last: at step 500 it sits too close to the rose to stay beside it.",
      "standard": {
        "1": {
          "$value": "{color.purple.500}"
        },
        "2": {
          "$value": "{color.red.600}"
        },
        "3": {
